# Variables del backend (funciones /api). Valores reales NO se commitean.
# - En Vercel: Project Settings → Environment Variables.
# - En local con `vercel dev`: copiá este archivo a `.env` (raíz) con los valores reales,
#   o ejecutá `vercel env pull`.
# (Los valores actuales de desarrollo están en src/.env, que está git-ignorado.)

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
AUTH_SECRET=
# Casilla emisora para el envío de correos vía Graph (requiere permiso de app Mail.Send).
# Opcional: si queda vacía, el envío server-side queda deshabilitado.
AZURE_MAIL_FROM=notificaciones@sumardigital.com.ar
